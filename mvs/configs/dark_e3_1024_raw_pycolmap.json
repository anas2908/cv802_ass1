{
  "schema_version": 1,
  "data_root": "${CV802_DATA_ROOT}/mvs",
  "experiment": "dark_e3_colmap_mvs_1024_raw_v1",
  "inputs": {"images": "inputs/images", "sparse_model": "inputs/sparse"},
  "masking": {"mode": "none"},
  "colmap": {
    "backend": "pycolmap", "python": "envs/mvs-engine/bin/python",
    "binary": "colmap", "gpu_index": "0"
  },
  "max_image_size": 1024,
  "patch_match": {
    "source_images_per_view": 5, "geom_consistency": true,
    "cache_size_gb": 8, "num_iterations": 3, "num_samples": 15,
    "window_radius": 5, "window_step": 1, "filter_min_num_consistent": 2
  },
  "fusion": {
    "cache_size_gb": 8, "min_num_pixels": 5, "max_reproj_error": 2.0,
    "max_depth_error": 0.01, "max_normal_error": 10.0, "check_num_images": 50
  },
  "meshing": "none",
  "execution": {"num_threads": 4, "require_slurm_job": true}
}
